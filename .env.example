# Stripe (modo test). Si no defines estas claves, el checkout corre en modo demostración.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Moneda de cobro en Stripe (usd por defecto). Si usas cop se convierte con la tasa de abajo.
STRIPE_CURRENCY=usd
# Tasa COP por USD usada para mostrar precios en pesos
NEXT_PUBLIC_COP_RATE=4000
